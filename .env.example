# Copiar como .env (NUNCA versionar .env) y rellenar.
# Credenciales de NASA Earthdata Login (https://urs.earthdata.nasa.gov)
# Opción 1: usuario y contraseña
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
# Opción 2 (alternativa): token generado en el perfil de Earthdata
# EARTHDATA_TOKEN=

# Rutas y despliegue
MECE_DATA_DIR=./data
MECE_APP_PORT=8502
